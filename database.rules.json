{
  "rules": {
    "zephyy": {
      "status": {
        ".read": true,
        ".write": "auth !== null"
      },
      "daily": {
        ".read": true,
        ".write": "auth !== null"
      },
      "chat": {
        "sessions": {
          "$sessionId": {
            "messages": {
              ".read": true,
              ".indexOn": [
                "timestamp"
              ],
              "$msgId": {
                ".write": "!data.exists() && newData.exists()",
                ".validate": "newData.hasChildren(['role', 'content', 'timestamp'])",
                "role": {
                  ".validate": "newData.val() === 'user'"
                },
                "content": {
                  ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 2000"
                },
                "timestamp": {
                  ".validate": "newData.isNumber()"
                },
                "$other": {
                  ".validate": false
                }
              }
            },
            "control": {
              ".read": true,
              ".write": "auth !== null || newData.child('state').val() === 'ended'"
            },
            "meta": {
              ".read": true,
              "page": {
                ".write": "newData.isString()",
                ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 64"
              },
              "$other": {
                ".validate": false
              }
            }
          }
        }
      },
      "feedback": {
        ".read": "auth !== null",
        ".write": "auth !== null"
      }
    },
    "printmon": {
      "themes": {
        ".read": true,
        ".write": "auth !== null"
      }
    },
    "config": {
      "worklinks": {
        ".read": true,
        ".write": "auth !== null"
      }
    }
  }
}
